    },
    {
      "@id": "cc:JUR-AU-VIC",
      "@type": "cc:JurisdictionRule",
      "name": "Victoria",
      "cc:status": "recognised_within_family_violence_framework"
    },
    {
      "@id": "cc:JUR-AU-WA",
      "@type": "cc:JurisdictionRule",
      "name": "Western Australia",
      "cc:status": "recognised_within_family_violence_framework"
    },
    {
      "@id": "cc:JUR-AU-TAS",
      "@type": "cc:JurisdictionRule",
      "name": "Tasmania",
      "cc:status": "specific_family_violence_offences_and_framework"
    },
    {
      "@id": "cc:JUR-AU-NT",
      "@type": "cc:JurisdictionRule",
      "name": "Northern Territory",
      "cc:status": "express_statutory_definition_within_domestic_violence_framework"
    }
  ],
  "cc:machinePolicy": {
    "@type": "cc:MachinePolicy",
    "version": "1.0.0",
    "cc:permitted": [
      "recognise_candidate_indicators",
      "translate_everyday_language_to_candidate_concepts",
      "correlate_observations",
      "identify_temporal_patterns",
      "identify_escalation",
      "surface_counterevidence",
      "preserve_uncertainty",
      "map_jurisdiction_rules",
      "recommend_safeguarding_review"
    ],
    "cc:prohibited": [
      "automatic_abuser_determination",
      "automatic_victim_determination",
      "automatic_legal_determination",
      "automatic_punitive_action",
      "automatic_contact_with_suspected_controlling_person",
      "unnecessary_identity_disclosure",
      "demographic_inference_as_evidence",
      "keyword_only_determination"
    ]
  },
  "cc:canonicalPrinciple": "People describe experiences. Machines identify candidate concepts. Evidence establishes context. Patterns support assessment. Jurisdiction rules determine legal relevance. Authorised humans make consequential decisions."
}