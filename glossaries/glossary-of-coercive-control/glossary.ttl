# Machine policy

cc:MachinePolicy-v1
    a cc:MachinePolicy ;
    schema:version "1.0.0" ;
    cc:permits "recognise_candidate_indicators",
               "translate_everyday_language_to_candidate_concepts",
               "correlate_observations",
               "identify_temporal_patterns",
               "identify_escalation",
               "surface_counterevidence",
               "preserve_uncertainty",
               "map_jurisdiction_rules",
               "recommend_safeguarding_review" ;
    cc:prohibits "automatic_abuser_determination",
                 "automatic_victim_determination",
                 "automatic_legal_determination",
                 "automatic_punitive_action",
                 "automatic_contact_with_suspected_controlling_person",
                 "unnecessary_identity_disclosure",
                 "demographic_inference_as_evidence",
                 "keyword_only_determination" .

# Canonical principle

cc:CanonicalPrinciple
    a skos:Concept ;
    skos:prefLabel "Canonical principle"@en-AU ;
    skos:definition "People describe experiences. Machines identify candidate concepts. Evidence establishes context. Patterns support assessment. Jurisdiction rules determine legal relevance. Authorised humans make consequential decisions."@en-AU .
