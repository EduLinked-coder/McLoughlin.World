    {
      "@id": "https://www.mcloughlin.world/glossaries/ssa-lexicon/term/constructive-exclusion/#concept",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Constructive Exclusion",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "When the system avoids saying “no” but designs impossible pathways that function as a no. This includes excessive forms, vague eligibility criteria, or open-ended application processes that technically exist—but aren’t meant to succeed.",
        "@language": "en-AU"
      },
