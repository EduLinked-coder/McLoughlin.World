    {
      "@id": "https://www.mcloughlin.world/glossaries/ssa-lexicon/term/legislation-laundering/#concept",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Legislation Laundering",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "The creation or layering of overlapping legislation, frameworks, agreements, standards, strategies, action plans and procedural systems in ways that obscure responsibility, diffuse accountability or prevent meaningful implementation. Legislation Laundering often creates the appearance of reform while making the actual governance landscape too fragmented, technical or contradictory for affected communities to navigate.",
        "@language": "en-AU"
      },
