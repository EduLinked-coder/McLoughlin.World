    {
      "@id": "https://www.mcloughlin.world/glossaries/ssa-lexicon/term/compliance-fragmentation/#concept",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Compliance Fragmentation",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "The division of compliance, safeguarding, accessibility, reporting and accountability obligations across disconnected systems with incompatible structures, language or processes. Compliance Fragmentation shifts the burden of coordination onto disabled people, advocates, families, peer workers, frontline staff and small organisations.",
        "@language": "en-AU"
      },
