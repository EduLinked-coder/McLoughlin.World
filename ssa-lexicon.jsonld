      ],
      "skos:prefLabel": {
        "@value": "Strategic Avoidance",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "When systems claim to be receptive to feedback but repeatedly route it to dead ends, irrelevant staff, or delayed “future planning cycles.” This tactic creates the illusion of inclusion while exhausting participants into silence.",
