      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "SSA™",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "A trauma-informed, systems-aware framework for reclaiming power. SSA™ is not a method of “being better behaved in broken systems.” It’s a protocol layer for surviving and influencing them with your dignity intact.",
        "@language": "en-AU"
      },
