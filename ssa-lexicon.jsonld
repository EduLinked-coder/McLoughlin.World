    {
      "@id": "https://www.mcloughlin.world/glossaries/ssa-lexicon/term/navigational-exhaustion/#concept",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Navigational Exhaustion",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "The exhaustion, burnout or disengagement caused by requiring people to navigate highly fragmented governance, service, legislative or compliance systems simultaneously. Navigational Exhaustion disproportionately impacts disabled people, neurodivergent people, people using AAC, people in crisis, peer advocates and families.",
        "@language": "en-AU"
      },
