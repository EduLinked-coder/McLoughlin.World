    {
      "@id": "https://www.mcloughlin.world/glossaries/ssa-lexicon/term/access-gatekeeping/#concept",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Access Gatekeeping",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "Requiring a person to conform to arbitrary or inappropriate standards to receive access — such as performing “helplessness” or agreeing not to disclose mistreatment.",
        "@language": "en-AU"
      },
