    {
      "@id": "https://www.mcloughlin.world/glossaries/ssa-lexicon/term/compliance-entrapment/#concept",
      "@type": [
        "skos:Concept",
        "schema:DefinedTerm",
        "ssa:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Compliance Entrapment",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "When a person follows the official rules but still ends up penalised because the system's true expectations are unspoken, inconsistent, or change without notice.",
        "@language": "en-AU"
      },
      "skos:notation": "compliance-entrapment",
