      ],
      "skos:prefLabel": {
        "@value": "Misplacement Strategy",
        "@language": "en-AU"
      },
      "skos:definition": {
        "@value": "Passing concerns from agency to agency until the original issue is diluted or abandoned. This form of bureaucratic ping-pong deflects responsibility under the guise of referral.",
